# Copy this file to config/vast.env and replace every <...> value.
PROJECT_DIR=/workspace/grasp-grpo-trainer
VENV_DIR=/workspace/grasp-grpo-trainer/.venv
READER_VENV=/workspace/grasp-reader-venv

# GPU 0 runs vLLM reader; GPU 1 runs GRPO when using one 2-GPU Vast instance.
READER_GPU=0
TRAIN_GPU=1
# One big GPU (>= 48GB) instead: READER_GPU=0, TRAIN_GPU=0, READER_GPU_UTIL=0.40.
READER_GPU_UTIL=0.90

SFT_CHECKPOINT=/workspace/checkpoints/grasp-qwen2.5-3b-sft
# 1 = nf4 base like the QLoRA SFT run and the SFT eval (actor and KL reference ~2GB each).
LOAD_IN_4BIT=1
# scripts/fetch_data_vast.sh downloads these. Training rows carry gold_doc_ids (reward only, never in prompts).
QA_FILE=/workspace/data/grasp-gold-evidence/train_mapped.jsonl
# Keys = each row's dataset; one shared Project A triple cache (doancuavahk/grasp-retrieval cache/triples.sqlite).
CORPUS_CONFIG=/workspace/grasp-grpo-trainer/config/corpora.vast.json
# Stages 0-3 write to $OUTPUT_ROOT/stage<N>; the full run (train_grpo_vast.sh) writes to $OUTPUT_DIR.
OUTPUT_ROOT=/workspace/outputs/grpo-protocol
OUTPUT_DIR=/workspace/outputs/grpo-final

READER_URL=http://127.0.0.1:8000/v1
READER_API_KEY="<set-a-long-reader-api-key>"
READER_MODEL=Qwen/Qwen2.5-7B-Instruct
# grasp = Project A reader protocol that generated the SFT data; legacy = the first GRPO run.
READER_PROTOCOL=grasp

# Fixed eval set (spec section 4). EVAL_QA is grasp-gold-evidence dev.jsonl.
EVAL_QA=/workspace/data/grasp-gold-evidence/dev.jsonl
EVAL_IDS=/workspace/grasp-grpo-trainer/config/eval_ids.json
EVAL_EVERY=50
# SFT F1 printed by stage 0 (stage0_grasp.json -> f1). Empty = measured again at step 0.
# Project A eval of the same adapter on the same 300 ids (2026-11-05): EM 0.457, F1 0.568, recall 0.739.
# Stage 0 (grasp protocol) should land close to that; a large gap means the environment still differs.
SFT_F1=

# Pilot (stage 3) defaults, spec section 3.4.
ITERATIONS=300
QUESTIONS_PER_ITERATION=16
WORKERS=16
SAVE_EVERY=50
MAX_HOURS=24
BRANCH_FACTOR=2
MAX_STEPS=5
MAX_LEAVES=4
LEARNING_RATE=1e-5
WARMUP_STEPS=20
CLIP_LOW=0.2
CLIP_HIGH=0.28
KL_BETA=0.002

ALPHA=0.3
SHAPING_SCALE=0.1
RETRIEVAL_COST=0.0
RD_GAIN_WEIGHT=0.3
QF_GAIN_WEIGHT=0.7
KI_HIT_WEIGHT=0.3
KI_MISS_PENALTY=0.1

# Full run only: continue from the pilot's best adapter.
ACTOR_CHECKPOINT=

# Live dashboard: small logs pushed to this private HF dataset (run scripts/dashboard.py locally).
LOG_SYNC=1
LOG_REPO=doancuavahk/grasp-grpo-logs
LOG_SYNC_SECONDS=180
