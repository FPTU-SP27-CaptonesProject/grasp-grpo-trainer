# Copy this file to config/vast.env and replace every <...> value.
PROJECT_DIR=/workspace/grasp-grpo-trainer
VENV_DIR=/workspace/grasp-grpo-trainer/.venv
READER_VENV=/workspace/grasp-reader-venv

# Two 24GB GPUs: GPU 0 serves the reader (port 8000) AND the 3B proxy (port 8001, scripts/run_policy_vast.sh);
# GPU 1 holds only the trainer (loss, reference, E5). Start the reader first, then the policy server.
READER_GPU=0
TRAIN_GPU=1
# E5 retrieval encoder on the vLLM GPU (~0.7 GB fp16), off the training GPU; empty = TRAIN_GPU.
RETRIEVER_GPU=0
READER_GPU_UTIL=0.52
POLICY_GPU=0
POLICY_GPU_UTIL=0.40
# Empty = generate with HF on TRAIN_GPU (slow: ~41 s per tree in stage 0); then READER_GPU_UTIL=0.90.
POLICY_URL=http://127.0.0.1:8001/v1
# 1 = rollouts for step t+1 run on GPU 0 while step t trains on GPU 1, one optimizer step behind; the loss
# then uses the sampler's log-probs as the old ones. Stage 2 (2026-11-07): ~120 s rollout + ~120 s backward
# per 8-question step, so this roughly halves the step time. Needs POLICY_URL.
ASYNC_ROLLOUT=1

SFT_CHECKPOINT=/workspace/checkpoints/grasp-qwen2.5-3b-sft
# 0 = bf16 base (~6GB, shared by the actor and the KL reference adapter): 2-3x faster generation.
# 1 = nf4 base like the QLoRA SFT run (stage 0 on 2026-11-05: F1 0.531, 47.9 s per tree on a 4090).
LOAD_IN_4BIT=0
# scripts/fetch_data_vast.sh downloads these. Training rows carry gold_doc_ids (reward only, never in prompts).
QA_FILE=/workspace/data/grasp-gold-evidence/train_mapped.jsonl
# Keys = each row's dataset; one shared Project A triple cache (doancuavahk/grasp-retrieval cache/triples.sqlite).
CORPUS_CONFIG=/workspace/grasp-grpo-trainer/config/corpora.vast.json
# ~21% of retrieved documents are not in the shared triple cache (stage 0, 2026-11-05). 1 = extract them with
# Project A's extractor (Qwen3-235B on Bedrock, ~$0.26 per 1000 documents) and add them to the cache.
# Each process stops extracting past EXTRACT_BUDGET_USD. Never commit this file: it holds the key.
EXTRACT_TRIPLES=1
EXTRACT_BUDGET_USD=10
BEDROCK_API_KEY="<bedrock-api-key>"
# BEDROCK_BASE_URL=https://bedrock-mantle.ap-southeast-2.api.aws/v1
# Stages 0-3 write to $OUTPUT_ROOT/stage<N>; the full run (train_grpo_vast.sh) writes to $OUTPUT_DIR.
OUTPUT_ROOT=/workspace/outputs/grpo-protocol
OUTPUT_DIR=/workspace/outputs/grpo-final

READER_URL=http://127.0.0.1:8000/v1
READER_API_KEY="<set-a-long-reader-api-key>"
READER_MODEL=Qwen/Qwen2.5-7B-Instruct
# grasp = Project A reader protocol that generated the SFT data; legacy = the first GRPO run.
READER_PROTOCOL=grasp

# Fixed eval set (spec section 4). EVAL_QA is grasp-gold-evidence dev.jsonl.
EVAL_QA=/workspace/data/grasp-gold-evidence/dev.jsonl
EVAL_IDS=/workspace/grasp-grpo-trainer/config/eval_ids.json
EVAL_EVERY=50
# SFT F1 printed by stage 0 (stage0_grasp.json -> f1). Empty = measured again at step 0.
# Project A eval of the same adapter on the same 300 ids (2026-11-05): EM 0.457, F1 0.568, recall 0.739.
# Stage 0 (grasp protocol) should land close to that; a large gap means the environment still differs.
SFT_F1=

# Pilot (stage 3) defaults, spec section 3.4.
ITERATIONS=300
QUESTIONS_PER_ITERATION=16
WORKERS=16
SAVE_EVERY=50
MAX_HOURS=24
BRANCH_FACTOR=2
MAX_STEPS=5
MAX_LEAVES=4
LEARNING_RATE=1e-5
WARMUP_STEPS=20
CLIP_LOW=0.2
CLIP_HIGH=0.28
KL_BETA=0.002

ALPHA=0.3
SHAPING_SCALE=0.1
RETRIEVAL_COST=0.0
RD_GAIN_WEIGHT=0.3
QF_GAIN_WEIGHT=0.7
KI_HIT_WEIGHT=0.3
KI_MISS_PENALTY=0.1

# Full run only: continue from the pilot's best adapter.
ACTOR_CHECKPOINT=
# Index of the first training question (file order, wraps). The pilot used questions 0..~3,700.
QUESTION_OFFSET=
# 1 = eval the starting adapter before step 1 even though SFT_F1 is set (resuming from a checkpoint).
INITIAL_EVAL=0
# Continue a stopped/crashed run exactly where it was: $OUTPUT_DIR/resume (rewritten after every step) or any
# checkpoint-grpo-step-* of a run started after 2026-11-11. Keep OUTPUT_DIR the same; ACTOR_CHECKPOINT and
# QUESTION_OFFSET are then ignored (optimizer, LR schedule, question cursor, early-stop state all come back).
RESUME=

# Live dashboard: small logs pushed to this private HF dataset (run scripts/dashboard.py locally).
LOG_SYNC=1
LOG_REPO=doancuavahk/grasp-grpo-logs
LOG_SYNC_SECONDS=180
